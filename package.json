{
  "name": "ai-security-pipeline",
  "version": "0.1.0",
  "description": "A generic, standalone AI-assisted security scanning pipeline: a Node/TypeScript CLI + GitHub Action that runs dependency and secret scans, then uses an LLM agent to triage findings by severity and suggest remediations.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-security-pipeline": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "openai": "^7.62.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
